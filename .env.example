# ─────────────────────────────────────────────────────────────
# .env.example - copy to .env and fill in YOUR keys. .env is gitignored.
# The /onboard flow fills this for you and never prints a key back to chat.
# Every value here is a placeholder. None of these are real.
# ─────────────────────────────────────────────────────────────

# ── Core: the brain ──────────────────────────────────────────
# Claude is the reasoning engine for both surfaces (IDE + Hermes phone agent).
# Get one at console.anthropic.com → API keys. Starts with sk-ant-.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Hermes: the phone agent (optional, macOS only) ───────────
# Telegram bot token from @BotFather. Looks like 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Your numeric Telegram user ID from @userinfobot. This is the security wall:
# messages from any other account are ignored.
TELEGRAM_ALLOWED_USERS=REPLACE_ME
# Which model Hermes thinks with. Haiku is fast + cheap for a phone agent.
HERMES_LLM_PROVIDER=anthropic
HERMES_LLM_MODEL=claude-haiku-4-5
# Absolute path to the workspace both surfaces share (optional).
HERMES_WORKSPACE=/Users/REPLACE_ME/path/to/your/workspace

# ── L3b long-term brains: NotebookLM (optional) ──────────────
# No official API - the community notebooklm CLI reads browser cookies.
# Nothing to put here; auth lives in ~/.notebooklm/auth.json after login.

# ── Add your own tools below as onboarding discovers them ────
# e.g. SUPABASE_URL=, STRIPE_SECRET_KEY=, GOOGLE_*, etc.
